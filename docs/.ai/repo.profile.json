{
  "repo_id": "core-toolkit-for-claude",
  "package_manager": "npm",
  "doc_roots": [
    "docs/L0_concept",
    "docs/L1_project",
    "docs/L2_development",
    "docs/L3_implementation"
  ],
  "commands": {
    "install": "./install.sh",
    "statusline:claude:install": "./scripts/setup_statusline_for_claude.sh",
    "statusline:codex:install": "./scripts/setup_statusline_for_codex.sh",
    "ci:install": "cd site && npm ci",
    "site:dev": "cd site && npm run docs:dev",
    "site:build": "cd site && npm run docs:build",
    "site:preview": "cd site && npm run docs:preview",
    "analyze:access": "python3 scripts/analyze_access.py --all",
    "analyze:auto-approve": "python3 scripts/analyze_auto_approve.py --all",
    "analyze:token-usage": "python3 scripts/analyze_token_usage.py --all",
    "test:approval-hooks": "bash tests/hooks/test-approval-hooks.sh",
    "test:mtg": "bash tests/commands/test-mtg.sh",
    "test:coding-guidelines": "bash tests/commands/test-coding-guidelines.sh",
    "test:task-manager": "bash tests/commands/test-task-manager.sh",
    "test:git-pr-merge": "bash tests/commands/test-git-pr-merge.sh",
    "test:install": "bash tests/install/test-install.sh",
    "test:codex-statusline": "bash tests/install/test-setup-statusline-for-codex.sh",
    "test:analysis-scripts": "python3 -m pytest tests/scripts/"
  },
  "active_commands": [
    "commands/work.md",
    "commands/work-multi.md",
    "commands/task-manager.md",
    "commands/mtg.md",
    "commands/analyze-access.md",
    "commands/analyze-auto-approve.md",
    "commands/analyze-token-usage.md",
    "commands/analyze-hazard-scan.md",
    "commands/triage-issues.md",
    "commands/triage-issues-for-hazard.md",
    "commands/new-issue.md",
    "commands/review-resolve.md",
    "commands/codex-review.md",
    "commands/task.md",
    "commands/patch.md",
    "commands/docs-sync.md",
    "commands/init-docs.md",
    "commands/concept-maker.md",
    "commands/coding-general.md",
    "commands/coding-py.md",
    "commands/coding-js.md",
    "commands/coding-ts.md",
    "commands/coding-sh.md",
    "commands/coding-react.md",
    "commands/coding-nextjs.md",
    "commands/git-commit.md",
    "commands/git-pr.md",
    "commands/git-pr-merge.md"
  ],
  "templates": [
    "templates/issue.md",
    "templates/pr.md",
    "templates/readme.md"
  ],
  "hooks": [
    "hooks/auto-approve-readonly.sh",
    "hooks/cleanup-session.sh",
    "hooks/guard-destructive-cmd.sh",
    "hooks/log-access-prompt.sh",
    "hooks/log-access-stop.sh",
    "hooks/log-access-tool.sh",
    "hooks/log-token-usage.sh",
    "hooks/notify-slack.sh",
    "hooks/tmux-agent-status.sh"
  ],
  "external_cli_deps": [
    "git",
    "gh",
    "jq",
    "node",
    "npm",
    "python3",
    "bc",
    "codex",
    "curl"
  ],
  "ci": {
    "workflows": [
      {
        "file": ".github/workflows/deploy.yml",
        "trigger": "push to main and workflow_dispatch",
        "runtime": "Node.js 24",
        "package_manager": "npm",
        "commands": [
          "npm ci",
          "npm run docs:build"
        ],
        "working_directory": "site",
        "purpose": "Build VitePress site in site/ and deploy site/.vitepress/dist to GitHub Pages"
      },
      {
        "file": ".github/workflows/shellcheck.yml",
        "trigger": "push to main and pull_request",
        "runtime": "ubuntu-latest (preinstalled shellcheck)",
        "commands": [
          "shellcheck -x <all *.sh files>"
        ],
        "purpose": "Run ShellCheck against every *.sh file in the repository"
      },
      {
        "file": ".github/workflows/test.yml",
        "trigger": "push to main and pull_request",
        "runtime": "ubuntu-latest, timeout-minutes: 10",
        "commands": [
          "bash tests/hooks/test-approval-hooks.sh"
        ],
        "purpose": "Run the PreToolUse approval hook safety test suite"
      }
    ]
  },
  "site": {
    "root": "site",
    "framework": "VitePress",
    "config": "site/.vitepress/config.mts",
    "package_file": "site/package.json",
    "lock_file": "site/package-lock.json"
  },
  "skills": [
    "skills/analyze-access/SKILL.md",
    "skills/analyze-auto-approve/SKILL.md",
    "skills/analyze-token-usage/SKILL.md",
    "skills/analyze-hazard-scan/SKILL.md",
    "skills/codex-review/SKILL.md",
    "skills/work/SKILL.md",
    "skills/work-multi/SKILL.md",
    "skills/task-manager/SKILL.md",
    "skills/mtg/SKILL.md",
    "skills/triage-issues/SKILL.md",
    "skills/triage-issues-for-hazard/SKILL.md",
    "skills/task/SKILL.md",
    "skills/patch/SKILL.md",
    "skills/docs-sync/SKILL.md",
    "skills/init-docs/SKILL.md",
    "skills/concept-maker/SKILL.md",
    "skills/new-issue/SKILL.md",
    "skills/review-resolve/SKILL.md",
    "skills/coding-general/SKILL.md",
    "skills/coding-py/SKILL.md",
    "skills/coding-js/SKILL.md",
    "skills/coding-ts/SKILL.md",
    "skills/coding-sh/SKILL.md",
    "skills/coding-react/SKILL.md",
    "skills/coding-nextjs/SKILL.md",
    "skills/git-commit/SKILL.md",
    "skills/git-pr/SKILL.md",
    "skills/git-pr-merge/SKILL.md"
  ],
  "primary_docs": {
    "investigation": "docs/L3_implementation/specification_summary.md",
    "structure": "docs/L1_project/repository_structure.md"
  },
  "deploy": {
    "commands": {
      "method": "symlink",
      "source": "commands/",
      "target": "~/.claude/commands/"
    },
    "codex_commands": {
      "method": "symlink",
      "source": "commands/",
      "target": "~/.codex/commands/"
    },
    "hooks": {
      "method": "symlink",
      "source": "hooks/",
      "target": "~/.claude/hooks/"
    },
    "claude_md": {
      "method": "symlink",
      "source": "global/CLAUDE.md",
      "target": "~/.claude/CLAUDE.md",
      "installer": "./install.sh"
    },
    "codex_agents_md": {
      "method": "symlink",
      "source": "global/CLAUDE.md",
      "target": "~/.codex/AGENTS.md",
      "installer": "./install.sh"
    },
    "skills": {
      "method": "symlink",
      "source": "skills/",
      "target": "~/.codex/skills/"
    },
    "templates": {
      "method": "symlink",
      "source": "templates/",
      "targets": [
        "~/.claude/templates/",
        "~/.codex/templates/"
      ],
      "installer": "./install.sh"
    },
    "statusline": {
      "method": "manual installer",
      "source": "scripts/statusline.sh",
      "target": "~/.claude/statusline.sh",
      "installer": "./scripts/setup_statusline_for_claude.sh"
    },
    "codex_statusline": {
      "method": "config.toml registration",
      "source": "scripts/setup_statusline_for_codex.sh",
      "target": "~/.codex/config.toml",
      "installer": "./install.sh"
    },
    "github_pages": {
      "method": "github-actions",
      "source": "site/.vitepress/dist",
      "workflow": ".github/workflows/deploy.yml"
    },
    "codex_hooks": {
      "method": "symlink + hooks.json registration",
      "source": "hooks/",
      "target": "~/.codex/hooks/",
      "config": "~/.codex/hooks.json"
    }
  }
}
